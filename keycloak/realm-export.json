{
  "realm": "helix",
  "displayName": "Helix",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "verifyEmail": true,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "rememberMe": false,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "passwordPolicy": "length(12) and notUsername and notEmail",
  "smtpServer": {
    "host": "${SMTP_HOST:mailhog}",
    "port": "${SMTP_PORT:1025}",
    "from": "${SMTP_FROM:noreply@helix.local}",
    "fromDisplayName": "Helix",
    "auth": "${SMTP_AUTH:false}",
    "user": "${SMTP_USER:}",
    "password": "${SMTP_PASSWORD:}",
    "ssl": "${SMTP_SSL:false}",
    "starttls": "${SMTP_STARTTLS:false}"
  },
  "roles": {
    "realm": [
      {
        "name": "helix-admin",
        "description": "Manages invitations and can read every user's experiments."
      },
      {
        "name": "helix-user",
        "description": "Can create and run experiments. Every user gets it as a default role."
      },
      {
        "name": "offline_access",
        "description": "${role_offline-access}"
      },
      {
        "name": "uma_authorization",
        "description": "${role_uma_authorization}"
      },
      {
        "name": "default-roles-helix",
        "description": "${role_default-roles}",
        "composite": true,
        "composites": {
          "realm": [
            "offline_access",
            "uma_authorization",
            "helix-user"
          ],
          "client": {
            "account": [
              "view-profile",
              "manage-account"
            ]
          }
        }
      }
    ]
  },
  "defaultRole": {
    "name": "default-roles-helix",
    "composite": true
  },
  "clients": [
    {
      "clientId": "helix-web",
      "name": "Helix web",
      "description": "Next.js app (Auth.js). Confidential; signs users in with the authorization code flow.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": true,
      "redirectUris": [
        "${APP_URL:http://localhost:3000}/*"
      ],
      "webOrigins": [
        "${APP_URL:http://localhost:3000}"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "${APP_URL:http://localhost:3000}/*"
      },
      "protocolMappers": [
        {
          "name": "helix-api audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "helix-api",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "consentRequired": false,
          "config": {
            "claim.name": "realm_access.roles",
            "multivalued": "true",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
            "userinfo.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "helix-api",
      "name": "Helix API",
      "description": "ASP.NET Core API. The JWT audience, and a service account for the admin API (invites) and for calling the EDA service.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "protocolMappers": [
        {
          "name": "helix-eda audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "helix-eda",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "helix-eda",
      "name": "Helix EDA service",
      "description": "Internal EDA service. Exists only as a token audience.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "standardFlowEnabled": false,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false
    }
  ],
  "users": [
    {
      "username": "service-account-helix-api",
      "enabled": true,
      "serviceAccountClientId": "helix-api",
      "clientRoles": {
        "realm-management": [
          "manage-users",
          "view-users",
          "query-users"
        ]
      }
    }
  ]
}
