# Copy to backend.hcl (gitignored) and fill in. See docs/deployment.md "Infrastructure".
# The bucket is created by hand once; it's not managed by this Terraform.
bucket                      = "helix-tfstate-<random>"
key                         = "helix/infra.tfstate"
region                      = "us-east-1" # ignored by Spaces, required by the backend
endpoints                   = { s3 = "https://lon1.digitaloceanspaces.com" }
skip_credentials_validation = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
skip_region_validation      = true
skip_s3_checksum            = true
use_path_style              = false
# credentials: AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars = a Spaces key with access to this bucket
