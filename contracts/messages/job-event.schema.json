{
  "$defs": {
    "JobError": {
      "additionalProperties": false,
      "description": "The error reported on a ``failed`` :class:`JobEvent`.",
      "properties": {
        "message": {
          "title": "Message",
          "type": "string"
        },
        "type": {
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type",
        "message"
      ],
      "title": "JobError",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A progress or outcome event published by a worker to ``jobs.events``.",
  "properties": {
    "entity_id": {
      "format": "uuid",
      "title": "Entity Id",
      "type": "string"
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/JobError"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "job_id": {
      "format": "uuid",
      "title": "Job Id",
      "type": "string"
    },
    "job_type": {
      "enum": [
        "training",
        "evaluation"
      ],
      "title": "Job Type",
      "type": "string"
    },
    "message": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Message"
    },
    "progress": {
      "anyOf": [
        {
          "maximum": 1,
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Progress"
    },
    "result": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    },
    "status": {
      "enum": [
        "started",
        "progress",
        "succeeded",
        "failed"
      ],
      "title": "Status",
      "type": "string"
    },
    "timestamp": {
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    }
  },
  "required": [
    "job_id",
    "job_type",
    "entity_id",
    "status"
  ],
  "title": "JobEvent",
  "type": "object"
}
