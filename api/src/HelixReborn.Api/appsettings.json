{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Secrets (connection string, client secrets) come from user-secrets locally and environment variables when
  // deployed. Never put them in this file. See docs/architecture.md for the full list.
  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "Keycloak": {
    "AuthServerUrl": "http://localhost:8080",
    "Realm": "helix",
    // The API's client ID; access tokens must carry it in "aud". Keycloak:Secret goes in user-secrets.
    "Resource": "helix-api"
  },

  "Invitations": {
    // The web app's URL. Invited users land here after setting their password; it must be a valid redirect URI of
    // the helix-web client.
    "AppUrl": "http://localhost:3000",
    "ClientId": "helix-web",
    "ExpiryDays": 7
  },

  "Helix": {
    // Overridden from the image's HELIX_VERSION; see docs/architecture.md (Delivery).
    "Version": "dev"
  }
}
