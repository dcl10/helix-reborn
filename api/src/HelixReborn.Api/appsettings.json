{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  // Secrets (connection string, client secrets) come from user-secrets locally and environment variables when
  // deployed. Never put them in this file. See docs/architecture.md for the full list.
  "ConnectionStrings": {
    "DefaultConnection": ""
  },

  "Keycloak": {
    "AuthServerUrl": "http://localhost:8080",
    "Realm": "helix",
    // The API's client ID; access tokens must carry it in "aud". Keycloak:Secret goes in user-secrets.
    "Resource": "helix-api"
  },

  "S3": {
    "ServiceUrl": "http://localhost:9000",
    "Region": "us-east-1",
    "Bucket": "helix",
    "ForcePathStyle": true
    // AccessKey and SecretKey go in appsettings.Development.json / user-secrets / the environment, never here.
  },

  "Invitations": {
    // The web app's URL. Invited users land here after setting their password; it must be a valid redirect URI of
    // the helix-web client.
    "AppUrl": "http://localhost:3000",
    "ClientId": "helix-web",
    "ExpiryDays": 7
  },

  "Eda": {
    // http://localhost:8001 when EDA runs in Compose; http://localhost:8000 with `uv run helix-eda`; http://eda:8000
    // inside Compose. Override with Eda__BaseUrl. Calls use a helix-api token, so Keycloak:Secret must be set.
    "BaseUrl": "http://localhost:8001",
    "Audience": "helix-eda",
    "TimeoutSeconds": 120
  },

  "Contracts": {
    // The generated contracts directory. Relative paths are looked for in the content root and its parents, so the
    // repo's contracts/ is found from dotnet run and tests; the Docker image sets Contracts__Root=/app/contracts.
    "Root": "contracts"
  },

  "Helix": {
    // Overridden from the image's HELIX_VERSION; see docs/architecture.md (Delivery).
    "Version": "dev"
  }
}
