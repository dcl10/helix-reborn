<Project>

  <!-- Central Package Management: every NuGet version lives here; project files reference packages without versions -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AspNetCoreVersion>10.0.13</AspNetCoreVersion>
    <!-- All EF Core packages (and the dotnet-ef tool in .config/dotnet-tools.json) must stay on the same version -->
    <EfCoreVersion>10.0.13</EfCoreVersion>
  </PropertyGroup>

  <!-- ASP.NET Core -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="$(AspNetCoreVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="$(AspNetCoreVersion)" />
  </ItemGroup>

  <!-- Keycloak admin API (invitations, #6): Kiota client plus client-credentials tokens for the helix-api service account -->
  <ItemGroup>
    <PackageVersion Include="Duende.AccessTokenManagement" Version="4.3.0" />
    <PackageVersion Include="Keycloak.AuthServices.Sdk.Kiota" Version="26.5.6" />
  </ItemGroup>

  <!-- Experiments and datasets (#13): S3-compatible object storage, CSV parsing -->
  <ItemGroup>
    <PackageVersion Include="AWSSDK.S3" Version="4.1.2" />
    <PackageVersion Include="CsvHelper" Version="34.1.0" />
  </ItemGroup>

  <!-- Pipelines (#24): validates each step's params against the catalog's JSON Schemas -->
  <ItemGroup>
    <PackageVersion Include="JsonSchema.Net" Version="9.7.0" />
  </ItemGroup>

  <!-- Training runs (#25): publishes jobs to and consumes events from RabbitMQ (async 7.x API) -->
  <ItemGroup>
    <PackageVersion Include="RabbitMQ.Client" Version="7.3.0" />
  </ItemGroup>

  <!-- EF Core -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
  </ItemGroup>

  <!-- Testing -->
  <ItemGroup>
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

</Project>
